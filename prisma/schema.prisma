generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}


/*
 * ============================================================
 * ENUMS
 * ============================================================
 */

enum RolUsuario {
  ADMIN
  HOSTESS
  WAITER
  CLEANING
}

enum EstadoMesa {
  AVAILABLE
  OCCUPIED
  DIRTY
  CLEANING
  BLOCKED
}

enum FormaMesa {
  RECTANGLE
  ROUND
}

enum EstadoTurno {
  WAITING
  SEATED
  CANCELLED
  COMPLETED
}

enum TipoEvento {
  WAITLIST_CREATED
  WAITLIST_CANCELLED
  TABLE_ASSIGNED
  TABLE_ASSIGNED_CAPACITY_OVERRIDE
  CUSTOMERS_LEFT
  CLEANING_STARTED
  CLEANING_FINISHED
  NFC_SCANNED
}

enum OrigenEvento {
  WEB
  ANDROID
  SYSTEM
}

enum TipoEtiquetaNfc {
  TABLE_OPERATION
  MENU
  FEEDBACK
}


/*
 * ============================================================
 * RESTAURANTE
 * ============================================================
 */

model Restaurante {
  id Int @id @default(autoincrement())

  nombre String

  slug String @unique

  menuUrl String? @map("menu_url")

  activo Boolean @default(true)

  usuarios Usuario[]

  pisos Piso[]

  mesas Mesa[]

  turnos Turno[]

  sesionesMesa SesionMesa[]

  eventos Evento[]

  etiquetasNfc EtiquetaNfc[]

  creadoEn DateTime @default(now()) @map("creado_en")

  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("restaurantes")
}


/*
 * ============================================================
 * USUARIO
 * ============================================================
 */

model Usuario {
  id Int @id @default(autoincrement())

  restauranteId Int @map("restaurante_id")

  nombre String

  correo String @unique

  /*
   * Nunca almacenamos la contraseña en texto plano.
   * Aquí se almacena el hash generado con bcrypt.
   */
  passwordHash String @map("password_hash")

  rol RolUsuario

  activo Boolean @default(true)

  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  sesionesAsignadas SesionMesa[] @relation("SesionAsignadaPor")

  sesionesCerradas SesionMesa[] @relation("SesionCerradaPor")

  eventos Evento[]

  creadoEn DateTime @default(now()) @map("creado_en")

  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([restauranteId])

  @@map("usuarios")
}


/*
 * ============================================================
 * PISO
 * ============================================================
 */

model Piso {
  id Int @id @default(autoincrement())

  restauranteId Int @map("restaurante_id")

  nombre String

  orden Int @default(1)

  activo Boolean @default(true)

  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  mesas Mesa[]

  creadoEn DateTime @default(now()) @map("creado_en")

  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@unique([restauranteId, nombre])

  @@index([restauranteId, orden])

  @@map("pisos")
}


/*
 * ============================================================
 * MESA
 * ============================================================
 */

model Mesa {
  id Int @id @default(autoincrement())

  restauranteId Int @map("restaurante_id")

  pisoId Int @map("piso_id")

  /*
   * String permite números e identificadores:
   * 01, 02, A1, T-01, etc.
   */
  numero String

  capacidad Int

  estado EstadoMesa @default(AVAILABLE)

  /*
   * Coordenadas usadas en el plano React Konva.
   */
  posicionX Int @default(0) @map("posicion_x")

  posicionY Int @default(0) @map("posicion_y")

  forma FormaMesa @default(RECTANGLE)

  activa Boolean @default(true)

  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  piso Piso @relation(fields: [pisoId], references: [id], onDelete: Cascade)

  sesiones SesionMesa[]

  eventos Evento[]

  etiquetasNfc EtiquetaNfc[]

  creadoEn DateTime @default(now()) @map("creado_en")

  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  /*
   * No puede haber dos mesas con el mismo número
   * dentro de un restaurante.
   */
  @@unique([restauranteId, numero])

  @@index([restauranteId, estado])

  @@index([pisoId])

  @@map("mesas")
}


/*
 * ============================================================
 * TURNO / LISTA DE ESPERA
 * ============================================================
 */

model Turno {
  id Int @id @default(autoincrement())

  restauranteId Int @map("restaurante_id")

  /*
   * Ejemplo:
   * A021
   */
  codigo String

  nombre String

  personas Int

  estado EstadoTurno @default(WAITING)

  fechaHoraLlegada DateTime @default(now()) @map("fecha_hora_llegada")

  sentadoEn DateTime? @map("sentado_en")

  canceladoEn DateTime? @map("cancelado_en")

  completadoEn DateTime? @map("completado_en")

  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  /*
   * Un turno genera como máximo una sesión de mesa.
   */
  sesionMesa SesionMesa?

  eventos Evento[]

  creadoEn DateTime @default(now()) @map("creado_en")

  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@unique([restauranteId, codigo])

  @@index([restauranteId, estado])

  @@index([fechaHoraLlegada])

  @@map("turnos")
}


/*
 * ============================================================
 * SESIÓN DE MESA
 * ============================================================
 *
 * Representa una ocupación concreta de una mesa.
 *
 * Ejemplo:
 *
 * Mesa 04
 * Capacidad normal = 4
 * Turno = 5 personas
 *
 * Si la hostess autoriza agregar una silla:
 *
 * capacidadOriginal = 4
 * personasTurno = 5
 * excedeCapacidad = true
 * personasExtra = 1
 * asignacionManual = true
 *
 * Mesa.capacidad continúa siendo 4.
 */

model SesionMesa {
  id Int @id @default(autoincrement())

  restauranteId Int @map("restaurante_id")

  mesaId Int @map("mesa_id")

  turnoId Int @unique @map("turno_id")

  /*
   * Usuario que hizo la asignación.
   */
  asignadoPorId Int @map("asignado_por_id")

  /*
   * Usuario que posteriormente cerró la sesión.
   */
  cerradoPorId Int? @map("cerrado_por_id")

  capacidadOriginal Int @map("capacidad_original")

  personasTurno Int @map("personas_turno")

  excedeCapacidad Boolean @default(false) @map("excede_capacidad")

  personasExtra Int @default(0) @map("personas_extra")

  asignacionManual Boolean @default(false) @map("asignacion_manual")

  inicio DateTime @default(now())

  fin DateTime?

  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  mesa Mesa @relation(fields: [mesaId], references: [id], onDelete: Restrict)

  turno Turno @relation(fields: [turnoId], references: [id], onDelete: Restrict)

  asignadoPor Usuario @relation("SesionAsignadaPor", fields: [asignadoPorId], references: [id], onDelete: Restrict)

  cerradoPor Usuario? @relation("SesionCerradaPor", fields: [cerradoPorId], references: [id], onDelete: Restrict)

  @@index([restauranteId])

  /*
   * Facilita buscar la sesión activa:
   *
   * mesaId = ?
   * fin = null
   */
  @@index([mesaId, fin])

  @@map("sesiones_mesa")
}


/*
 * ============================================================
 * EVENTOS / HISTORIAL
 * ============================================================
 */

model Evento {
  id Int @id @default(autoincrement())

  restauranteId Int @map("restaurante_id")

  /*
   * Algunos eventos no están vinculados
   * directamente con una mesa.
   */
  mesaId Int? @map("mesa_id")

  /*
   * Algunos eventos no necesitan turno.
   */
  turnoId Int? @map("turno_id")

  /*
   * Puede ser null cuando la acción
   * fue realizada automáticamente.
   */
  usuarioId Int? @map("usuario_id")

  tipo TipoEvento

  descripcion String

  origen OrigenEvento

  /*
   * Información adicional opcional.
   *
   * Ejemplo:
   *
   * {
   *   "capacidad": 4,
   *   "personas": 5,
   *   "personasExtra": 1
   * }
   */
  metadata Json?

  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  mesa Mesa? @relation(fields: [mesaId], references: [id], onDelete: SetNull)

  turno Turno? @relation(fields: [turnoId], references: [id], onDelete: SetNull)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  fechaHora DateTime @default(now()) @map("fecha_hora")

  @@index([restauranteId, fechaHora])

  @@index([mesaId])

  @@index([turnoId])

  @@index([usuarioId])

  @@map("eventos")
}


/*
 * ============================================================
 * ETIQUETAS NFC
 * ============================================================
 *
 * Ejemplo de contenido físico en NTAG213:
 *
 * v=1;t=7fb1d324b16d49c39a8074d410f5345a
 *
 * La etiqueta contiene el token.
 *
 * PostgreSQL NO conserva ese token directamente.
 * Guarda solamente SHA-256(token).
 */

model EtiquetaNfc {
  id Int @id @default(autoincrement())

  restauranteId Int @map("restaurante_id")

  /*
   * Es nullable porque una etiqueta futura de tipo
   * MENU o FEEDBACK no necesariamente pertenece
   * a una mesa concreta.
   */
  mesaId Int? @map("mesa_id")

  /*
   * SHA-256 hexadecimal ocupa 64 caracteres.
   */
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  tipo TipoEtiquetaNfc

  activa Boolean @default(true)

  ultimoUsoEn DateTime? @map("ultimo_uso_en")

  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  mesa Mesa? @relation(fields: [mesaId], references: [id], onDelete: SetNull)

  creadoEn DateTime @default(now()) @map("creado_en")

  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([restauranteId, tipo])

  @@index([mesaId])

  @@map("etiquetas_nfc")
}