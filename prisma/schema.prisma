generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

/**
 * ============================================================
 * ENUMS
 * ============================================================
 */

enum RolUsuario {
  ADMIN
  HOSTESS
  WAITER
  CLEANING
}

enum EstadoMesa {
  AVAILABLE
  OCCUPIED
  DIRTY
  CLEANING
  BLOCKED
}

enum FormaMesa {
  RECTANGLE
  ROUND
}

enum EstadoTurno {
  WAITING
  SEATED
  CANCELLED
  COMPLETED
}

enum TipoEvento {
  WAITLIST_CREATED
  WAITLIST_UPDATED
  WAITLIST_CALLED
  WAITLIST_CANCELLED
  TABLE_ASSIGNED
  TABLE_ASSIGNED_CAPACITY_OVERRIDE
  CUSTOMERS_LEFT
  CLEANING_STARTED
  CLEANING_FINISHED
  NFC_SCANNED
  NFC_TAG_LINKED
}

enum OrigenEvento {
  WEB
  ANDROID
  SYSTEM
}

enum TipoEtiquetaNfc {
  TABLE_OPERATION
  MENU
  FEEDBACK
}

/**
 * ============================================================
 * RESTAURANTE
 * ============================================================
 */

model Restaurante {
  id Int @id @default(autoincrement())

  nombre String

  slug String @unique

  /**
   * Estos campos ya existen en el formulario
   * de configuración del frontend.
   */
  telefono String? @db.VarChar(30)

  direccion String? @db.VarChar(255)

  /**
   * Se utilizará más adelante para el menú
   * público mediante NFC.
   */
  menuUrl String? @map("menu_url")

  activo Boolean @default(true)

  /**
   * Relaciones.
   */
  usuarios Usuario[]

  pisos Piso[]

  mesas Mesa[]

  turnos Turno[]

  sesionesMesa SesionMesa[]

  eventos Evento[]

  etiquetasNfc EtiquetaNfc[]

  creadoEn DateTime @default(now()) @map("creado_en")

  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("restaurantes")
}

/**
 * ============================================================
 * USUARIO
 * ============================================================
 * Cada empleado posee su propia cuenta.
 * ADMIN
 * HOSTESS
 * WAITER
 * CLEANING
 * Esto permite saber qué usuario realizó
 * cada operación.
 */

model Usuario {
  id Int @id @default(autoincrement())

  restauranteId Int @map("restaurante_id")

  nombre String

  correo String @unique

  /**
   * Nunca se almacena la contraseña directamente.
   * Se guarda el hash generado con bcrypt.
   */
  passwordHash String @map("password_hash")

  rol RolUsuario

  activo Boolean @default(true)

  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  /**
   * Sesiones de mesa que este usuario asignó.
   */
  sesionesAsignadas SesionMesa[] @relation("SesionAsignadaPor")

  /**
   * Sesiones de mesa que este usuario cerró
   * al indicar que los clientes se retiraron.
   */
  sesionesCerradas SesionMesa[] @relation("SesionCerradaPor")

  eventos Evento[]

  creadoEn DateTime @default(now()) @map("creado_en")

  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([restauranteId])
  @@index([restauranteId, rol])
  @@map("usuarios")
}

/**
 * ============================================================
 * PISO / ZONA
 * ============================================================
 * Un piso también funciona como una zona del restaurante.
 * Ejemplos:
 * Planta baja
 * Terraza
 * Primer piso
 * Jardín
 */

model Piso {
  id Int @id @default(autoincrement())

  restauranteId Int @map("restaurante_id")

  nombre String

  orden Int @default(1)

  activo Boolean @default(true)

  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  mesas Mesa[]

  /**
   * Turnos que indicaron preferencia por
   * este piso o zona.
   * La preferencia NO obliga a que el cliente
   * sea sentado ahí.
   */
  turnosPreferidos Turno[] @relation("TurnoPisoPreferido")

  creadoEn DateTime @default(now()) @map("creado_en")

  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@unique([restauranteId, nombre])
  @@index([restauranteId, orden])
  @@map("pisos")
}

/**
 * ============================================================
 * MESA
 * ============================================================
 */

model Mesa {
  id Int @id @default(autoincrement())

  restauranteId Int @map("restaurante_id")

  pisoId Int @map("piso_id")

  /**
   * Se mantiene como String porque permite:
   * 01
   * 02
   * A1
   * T-01
   * aunque actualmente utilizaremos números.
   */
  numero String

  capacidad Int

  estado EstadoMesa @default(AVAILABLE)

  /**
   * Coordenadas utilizadas por React Konva
   * para dibujar el plano.
   */
  posicionX Int @default(0) @map("posicion_x")

  posicionY Int @default(0) @map("posicion_y")

  forma FormaMesa @default(RECTANGLE)

  activa Boolean @default(true)

  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  piso Piso @relation(fields: [pisoId], references: [id], onDelete: Cascade)

  /**
   * Historial de ocupaciones de la mesa.
   */
  sesiones SesionMesa[]

  eventos Evento[]

  etiquetasNfc EtiquetaNfc[]

  creadoEn DateTime @default(now()) @map("creado_en")

  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  /**
   * Dos mesas del mismo restaurante
   * no pueden tener el mismo número.
   */
  @@unique([restauranteId, numero])
  @@index([restauranteId, estado])
  @@index([pisoId])
  @@map("mesas")
}

/**
 * ============================================================
 * TURNO / LISTA DE ESPERA
 * ============================================================
 * Ya NO utilizamos códigos A021, A022, etc.
 * El cliente verá:
 * Turno #1
 * Turno #2
 * Turno #3
 * El campo id continúa existiendo únicamente
 * como identificador interno de PostgreSQL.
 */

model Turno {
  id Int @id @default(autoincrement())

  restauranteId Int @map("restaurante_id")

  /**
   * Número visible para cliente y personal.
   */
  numero Int

  /**
   * Permite reiniciar la numeración cada día:
   * Hoy:
   * Turno #1
   * Turno #2
   * Mañana:
   * Turno #1
   * Turno #2
   */
  fechaOperacion DateTime @default(now()) @map("fecha_operacion") @db.Date

  nombre String

  personas Int

  /**
   * Preferencia opcional del cliente.
   * null = Sin preferencia
   */
  pisoPreferidoId Int? @map("piso_preferido_id")

  estado EstadoTurno @default(WAITING)

  fechaHoraLlegada DateTime @default(now()) @map("fecha_hora_llegada")

  /**
   * La hostess puede llamar un turno.
   * Llamarlo NO significa que ya esté sentado.
   * El turno sigue en WAITING.
   */
  llamadoEn DateTime? @map("llamado_en")

  /**
   * Momento en que el mesero confirma
   * físicamente al cliente en una mesa.
   */
  sentadoEn DateTime? @map("sentado_en")

  canceladoEn DateTime? @map("cancelado_en")

  /**
   * Se establece cuando los clientes
   * finalmente se retiran de la mesa.
   */
  completadoEn DateTime? @map("completado_en")

  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  pisoPreferido Piso? @relation("TurnoPisoPreferido", fields: [pisoPreferidoId], references: [id], onDelete: SetNull)

  /**
   * Un turno puede generar como máximo
   * una sesión de mesa.
   * Mientras está WAITING esta relación es null.
   */
  sesionMesa SesionMesa?

  eventos Evento[]

  creadoEn DateTime @default(now()) @map("creado_en")

  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  /**
   * Permite que la numeración vuelva a comenzar
   * desde 1 cada día.
   * Ejemplo:
   * restaurante 1 + 2026-09-30 + turno 1
   * sólo puede existir una vez.
   */
  @@unique([restauranteId, fechaOperacion, numero])
  @@index([restauranteId, estado])
  @@index([restauranteId, fechaOperacion, estado])
  @@index([pisoPreferidoId])
  @@index([fechaHoraLlegada])
  @@index([llamadoEn])
  @@map("turnos")
}

/**
 * ============================================================
 * SESIÓN DE MESA
 * ============================================================
 * Aquí nace realmente la relación:
 * Turno <-> Mesa
 * NO asignamos una mesa desde la lista de espera.
 * Primero:
 * Turno #7
 * Carlos
 * WAITING
 * Después el cliente llega físicamente a una mesa.
 * El mesero:
 * 1. Escanea NFC
 * o selecciona la mesa desde el mapa.
 * 2. Pregunta nombre / número de turno.
 * 3. Selecciona Turno #7.
 * 4. Confirma.
 * Sólo entonces se crea SesionMesa.
 */

model SesionMesa {
  id Int @id @default(autoincrement())

  restauranteId Int @map("restaurante_id")

  mesaId Int @map("mesa_id")

  /**
   * @unique evita que el mismo turno
   * sea asignado a dos mesas.
   */
  turnoId Int @unique @map("turno_id")

  /**
   * Usuario que confirmó la asignación.
   * Normalmente será un WAITER,
   * HOSTESS o ADMIN.
   */
  asignadoPorId Int @map("asignado_por_id")

  /**
   * Usuario que indicó que los clientes
   * se retiraron.
   */
  cerradoPorId Int? @map("cerrado_por_id")

  /**
   * Guardamos la capacidad que tenía la mesa
   * en ese momento para conservar el historial.
   */
  capacidadOriginal Int @map("capacidad_original")

  personasTurno Int @map("personas_turno")

  /**
   * Ejemplo:
   * Mesa = 4
   * Personas = 5
   * excedeCapacidad = true
   * personasExtra = 1
   */
  excedeCapacidad Boolean @default(false) @map("excede_capacidad")

  personasExtra Int @default(0) @map("personas_extra")

  /**
   * Indica que ADMIN/HOSTESS autorizó
   * explícitamente una excepción de capacidad.
   * No se refiere a seleccionar la mesa
   * manualmente desde Android.
   */
  excepcionCapacidadAutorizada Boolean @default(false) @map("excepcion_capacidad_autorizada")

  inicio DateTime @default(now())

  fin DateTime?

  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  mesa Mesa @relation(fields: [mesaId], references: [id], onDelete: Restrict)

  turno Turno @relation(fields: [turnoId], references: [id], onDelete: Restrict)

  asignadoPor Usuario @relation("SesionAsignadaPor", fields: [asignadoPorId], references: [id], onDelete: Restrict)

  cerradoPor Usuario? @relation("SesionCerradaPor", fields: [cerradoPorId], references: [id], onDelete: Restrict)

  /**
   * Nos permite consultar rápidamente
   * las ocupaciones de cada restaurante.
   */
  @@index([restauranteId])
  /**
   * Para localizar la sesión activa:
   * mesaId = X
   * fin = null
   */
  @@index([mesaId, fin])
  @@map("sesiones_mesa")
}

/**
 * ============================================================
 * EVENTOS / HISTORIAL
 * ============================================================
 * El historial nos permite conocer:
 * qué pasó
 * cuándo pasó
 * en qué mesa
 * con qué turno
 * qué usuario lo hizo
 * desde qué aplicación se hizo
 */

model Evento {
  id Int @id @default(autoincrement())

  restauranteId Int @map("restaurante_id")

  /**
   * Nullable porque existen eventos,
   * como crear o llamar un turno,
   * que todavía no tienen mesa.
   */
  mesaId Int? @map("mesa_id")

  turnoId Int? @map("turno_id")

  /**
   * Puede ser null cuando una acción
   * es generada automáticamente por el sistema.
   */
  usuarioId Int? @map("usuario_id")

  tipo TipoEvento

  descripcion String

  /**
   * WEB
   * ANDROID
   * SYSTEM
   */
  origen OrigenEvento

  /**
   * Datos complementarios.
   * Ejemplos:
   * {
   * "metodo": "NFC"
   * }
   * {
   * "metodo": "MANUAL"
   * }
   * {
   * "capacidad": 4,
   * "personas": 5,
   * "personasExtra": 1
   * }
   */
  metadata Json?

  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  mesa Mesa? @relation(fields: [mesaId], references: [id], onDelete: SetNull)

  turno Turno? @relation(fields: [turnoId], references: [id], onDelete: SetNull)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  fechaHora DateTime @default(now()) @map("fecha_hora")

  @@index([restauranteId, fechaHora])
  @@index([mesaId])
  @@index([turnoId])
  @@index([usuarioId])
  @@map("eventos")
}

/**
 * ============================================================
 * ETIQUETAS NFC
 * ============================================================
 * Para las etiquetas operativas:
 * NTAG213
 * Ejemplo de contenido:
 * v=1;t=7fb1d324b16d49c39a8074d410f5345a
 * El token real NO se almacena en PostgreSQL.
 * PostgreSQL conserva:
 * SHA-256(token)
 */

model EtiquetaNfc {
  id Int @id @default(autoincrement())

  restauranteId Int @map("restaurante_id")

  /**
   * TABLE_OPERATION normalmente tendrá mesa.
   * MENU o FEEDBACK pueden no estar ligados
   * directamente con una mesa.
   */
  mesaId Int? @map("mesa_id")

  /**
   * Un SHA-256 hexadecimal contiene
   * exactamente 64 caracteres.
   */
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  tipo TipoEtiquetaNfc

  activa Boolean @default(true)

  ultimoUsoEn DateTime? @map("ultimo_uso_en")

  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  mesa Mesa? @relation(fields: [mesaId], references: [id], onDelete: SetNull)

  creadoEn DateTime @default(now()) @map("creado_en")

  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([restauranteId, tipo])
  @@index([mesaId])
  @@map("etiquetas_nfc")
}
